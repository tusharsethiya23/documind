# Copy this file to .env and fill it in. Never commit .env.

# API server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=50

# MongoDB Atlas connection string (Atlas UI → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=documind

# LLM provider: claude | ollama
LLM_PROVIDER=claude

# Claude: https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (lower is faster and cheaper)
CLAUDE_EFFORT=medium

# Ollama (free, local): https://ollama.com, then `ollama pull llama3.2`
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Retrieval
TOP_K=6
# hybrid (vector + keyword, recommended) | vector | keyword
SEARCH_MODE=hybrid
# Atlas cosine score is (1 + cosine) / 2. Below this, answer "I don't know".
MIN_SCORE=0.72
