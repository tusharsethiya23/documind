# Copy this file to .env and fill it in. Never commit .env.

# API server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=50

# MongoDB Atlas connection string (Atlas UI → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=documind

# LLM provider: claude | groq | ollama
LLM_PROVIDER=claude

# Claude: https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (lower is faster and cheaper)
CLAUDE_EFFORT=medium

# Groq (free tier, hosted, used for the online demo): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (free, local): https://ollama.com, then `ollama pull llama3.2`
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Retrieval
TOP_K=6
# hybrid (vector + keyword, recommended) | vector | keyword
SEARCH_MODE=hybrid
# Re-score the top search results with a local cross-encoder (more precise ranking)
RERANK=true
RERANK_CANDIDATES=20
# Passages the reranker scores below this are not sent to the LLM (irrelevant ones score around -10)
RERANK_MIN_SCORE=-5
# Answer "I don't know" if even the best passage's rerank score is below this
RERANK_GATE=-4
# Atlas cosine score is (1 + cosine) / 2. Below this, answer "I don't know".
MIN_SCORE=0.72

# Public demo (hosted): read-only library, per-IP question limit, proxy-aware IPs
READ_ONLY=false
ASK_LIMIT_PER_10_MIN=0
TRUST_PROXY=0
# Folder with the built React app to serve from the API (the root Dockerfile sets this)
CLIENT_DIST=
